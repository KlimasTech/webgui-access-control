<script markdown="0">
(function () {
  var WAC = {
    csrfToken: <?=json_encode($csrfToken)?>,
    apiUrl: '/plugins/webgui-access-control/scripts/users_api.php',
    allSections: [],
    nativeUsers: [],
  };

  function $(id) { return document.getElementById(id); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  function wacFetch(params) {
    var body = new URLSearchParams(params);
    body.append('csrf_token', WAC.csrfToken);
    return fetch(WAC.apiUrl, { method: 'POST', body: body }).then(function (r) {
      return r.text().then(function (text) {
        if (!text) { throw new Error('Pusta odpowiedz serwera (HTTP ' + r.status + ')'); }
        try { return JSON.parse(text); }
        catch (e) {
          if (text.trim().charAt(0) === '<') {
            throw new Error('Serwer zwrocil strone HTML zamiast danych - sesja mogla wygasnac. Odswiez strone.');
          }
          throw new Error('Nieprawidlowa odpowiedz (HTTP ' + r.status + ')');
        }
      });
    });
  }

  function showStatus(ok, msg) {
    var el = $('wac-status');
    el.className = 'wac-status ' + (ok ? 'ok' : 'err');
    el.textContent = msg;
  }

  function renderSectionChecks(selected) {
    selected = selected || [];
    var box = $('wac-sections');
    box.innerHTML = WAC.allSections.map(function (s) {
      var checked = selected.indexOf(s) !== -1 ? 'checked' : '';
      return '<label><input type="checkbox" class="wac-sec-cb" value="' + esc(s) + '" ' + checked + '>' + esc(s) + '</label>';
    }).join('');
  }

  function renderTable(users) {
    var tbody = $('wac-tbody');
    if (!users.length) {
      tbody.innerHTML = '<tr><td colspan="6">Brak dodatkowych kont - tylko root.</td></tr>';
      return;
    }
    tbody.innerHTML = users.map(function (u) {
      var typeLabel = u.type === 'native' ? 'unRAID' : 'niestandardowe';
      var rolePill = '<span class="pill ' + (u.role === 'admin' ? 'admin' : 'user') + '">' + esc(u.role) + '</span>';
      var statusPill = u.enabled ? '<span class="pill user">aktywne</span>' : '<span class="pill off">wylaczone</span>';
      var sections = (u.sections || []).map(function (s) { return '<span class="sec-tag">' + esc(s) + '</span>'; }).join('') || '<i>brak</i>';
      return '<tr>' +
        '<td>' + esc(u.username) + '</td>' +
        '<td>' + esc(typeLabel) + '</td>' +
        '<td>' + rolePill + '</td>' +
        '<td>' + statusPill + '</td>' +
        '<td>' + sections + '</td>' +
        '<td>' +
          '<a href="#" class="wac-edit-link" data-username="' + esc(u.username) + '">edytuj</a> | ' +
          '<a href="#" class="wac-del-link" data-username="' + esc(u.username) + '" style="color:#ff8080;">usun</a>' +
        '</td>' +
      '</tr>';
    }).join('');

    tbody.querySelectorAll('.wac-edit-link').forEach(function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); startEdit(a.dataset.username, users); });
    });
    tbody.querySelectorAll('.wac-del-link').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        if (!confirm('Usunac konto "' + a.dataset.username + '"?')) return;
        wacFetch({ action: 'delete', username: a.dataset.username })
          .then(function (d) {
            if (!d.ok) { showStatus(false, d.error); return; }
            showStatus(true, 'Usunieto konto.');
            load();
          })
          .catch(function (e) { showStatus(false, e.message); });
      });
    });
  }

  function populateNativeSelect() {
    var sel = $('wac-native-select');
    if (!sel) return;
    if (!WAC.nativeUsers.length) {
      sel.innerHTML = '<option value="">(brak dostepnych kont unRAID - wszystkie juz skonfigurowane lub nie utworzono zadnego w panelu Uzytkownicy)</option>';
      return;
    }
    sel.innerHTML = WAC.nativeUsers.map(function (u) { return '<option value="' + esc(u) + '">' + esc(u) + '</option>'; }).join('');
  }

  function applyTypeVisibility() {
    var isNative = $('wac-type').value === 'native';
    $('wac-native-field').style.display = isNative ? '' : 'none';
    $('wac-username-field').style.display = isNative ? 'none' : '';
    $('wac-password-field').style.display = isNative ? 'none' : '';
  }

  function startEdit(username, users) {
    var u = users.find(function (x) { return x.username === username; });
    if (!u) return;
    $('wac-edit-mode').value = 'edit';
    $('wac-type').value = u.type === 'native' ? 'native' : 'custom';
    $('wac-type').disabled = true;
    applyTypeVisibility();
    $('wac-username').value = u.username;
    $('wac-username').disabled = true;
    $('wac-native-select').value = u.username;
    $('wac-native-select').disabled = true;
    $('wac-password').value = '';
    $('wac-role').value = u.role;
    $('wac-enabled').checked = !!u.enabled;
    renderSectionChecks(u.sections);
    $('wac-form-title').textContent = 'Edycja konta: ' + u.username;
    $('wac-cancel').style.display = '';
    window.scrollTo({ top: $('wac-form').getBoundingClientRect().top + window.scrollY - 20, behavior: 'smooth' });
  }

  function resetForm() {
    $('wac-edit-mode').value = 'create';
    $('wac-type').value = 'custom';
    $('wac-type').disabled = false;
    $('wac-username').value = '';
    $('wac-username').disabled = false;
    $('wac-native-select').disabled = false;
    populateNativeSelect();
    $('wac-password').value = '';
    $('wac-role').value = 'user';
    $('wac-enabled').checked = true;
    applyTypeVisibility();
    renderSectionChecks([]);
    $('wac-form-title').textContent = 'Dodaj konto';
    $('wac-cancel').style.display = 'none';
  }

  function load() {
    wacFetch({ action: 'list' })
      .then(function (d) {
        if (!d.ok) { showStatus(false, d.error); return; }
        WAC.allSections = d.sections;
        WAC.nativeUsers = d.nativeUsers || [];
        renderTable(d.users);
        populateNativeSelect();
        if ($('wac-sections').children.length === 0) { renderSectionChecks([]); }
      })
      .catch(function (e) { showStatus(false, e.message); });
  }

  function bindForm() {
    $('wac-type').addEventListener('change', applyTypeVisibility);
    $('wac-save').addEventListener('click', function () {
      var sections = Array.from(document.querySelectorAll('.wac-sec-cb:checked')).map(function (c) { return c.value; });
      var type = $('wac-type').value;
      var username = type === 'native' ? $('wac-native-select').value : $('wac-username').value.trim();
      wacFetch({
        action: 'save',
        type: type,
        username: username,
        password: $('wac-password').value,
        role: $('wac-role').value,
        enabled: $('wac-enabled').checked ? '1' : '',
        sections: JSON.stringify(sections),
      }).then(function (d) {
        if (!d.ok) { showStatus(false, d.error); return; }
        showStatus(true, 'Zapisano konto.');
        resetForm();
        load();
      }).catch(function (e) { showStatus(false, e.message); });
    });
    $('wac-cancel').addEventListener('click', resetForm);
  }

  function init() {
    if (!$('wac-form')) { return; }
    bindForm();
    resetForm();
    load();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
